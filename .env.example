# Copy this file to .env and fill in the values. .env is ignored by git.

# --- The app ---
# Required. Your OpenAI API key.
OPENAI_API_KEY=
# Optional. Any chat model your key can use (default: gpt-5.6-terra).
OPENAI_MODEL=gpt-5.6-terra

# Optional. Starting values for the connection form in the sidebar.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chatbot_reader
# Leave empty to type the password in the sidebar instead.
DB_PASSWORD=
DB_NAME=Chinook

# --- The demo database (compose.yaml) ---
# Required by docker compose. Pick your own strong passwords.
MYSQL_ROOT_PASSWORD=
# Password for chatbot_reader, the read-only user the app connects as.
READER_PASSWORD=
# Port on 127.0.0.1 for the demo database. If you change it, change DB_PORT too.
MYSQL_PORT=3306
